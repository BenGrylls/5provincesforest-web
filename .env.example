# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าสองบรรทัดล่างให้ครบ
# ห้าม commit ไฟล์ .env เด็ดขาด (อยู่ใน .gitignore แล้ว)

# ตรงกับค่าใน docker-compose.yml — ใช้ได้เลยบนเครื่อง dev
# บน production ต้องเปลี่ยนเป็นค่าจริงของเซิร์ฟเวอร์
DATABASE_URL="postgresql://admin:password123@localhost:5432/forest_db"

# บัญชี super admin — ไม่ได้เก็บในฐานข้อมูล อ่านจากไฟล์นี้โดยตรง
ADMIN_USERNAME="admin"

# รหัสผ่านสำหรับล็อกอินหน้า /admin/login (อย่างน้อย 8 ตัวอักษร)
# สร้างด้วย: openssl rand -base64 12
ADMIN_PASSWORD="replace-with-a-long-unique-password"

# กุญแจลับสำหรับเซ็นลายเซ็น cookie (HMAC) ไม่ใช่รหัสผ่าน (อย่างน้อย 32 ตัวอักษร)
# ถ้าเปลี่ยนค่านี้ คนที่ล็อกอินค้างไว้จะหลุดทั้งหมด
# สร้างด้วย: openssl rand -hex 32
ADMIN_SESSION_TOKEN="replace-with-at-least-32-random-characters"
